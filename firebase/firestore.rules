rules_version = '2';

// Discipline — Firestore security rules.
//
// Principles:
//  * Every private document carries `userId`; only that user can read it.
//  * Research-relevant outcomes (verified / rejected / uncertain / resolved / failed) are
//    written ONLY by Cloud Functions (Admin SDK bypasses these rules). A client can never
//    mark its own evidence as verified.
//  * The experimental condition and participant ID are immutable once written.
//  * Verification results and exercise sessions are append-only.
//  * Research records are readable by researchers (custom claim `researcher: true`) only.
//  * Date fields are never compared for equality: Swift `Date` is a Double, so a
//    Timestamp -> Date -> Timestamp round trip can differ by a nanosecond.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isResearcher() { return signedIn() && request.auth.token.researcher == true; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.userId == request.auth.uid; }
    function idMatches(id) { return request.resource.data.id == id; }
    function unchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create: if isSelf(uid)
        && idMatches(uid)
        && request.resource.data.participantId is string
        && request.resource.data.participantId.matches('^P-[A-Z2-9]{10}$')
        && request.resource.data.trackingCondition in ['manual', 'aiAssisted']
        && !('conditionAssignedBy' in request.resource.data);
      // The condition and its assignment metadata are set by the server (onUserProfileCreated).
      allow update: if isSelf(uid)
        && unchanged(['id', 'participantId', 'trackingCondition', 'conditionAssignedBy', 'conditionAssignedAt']);
      allow delete: if isSelf(uid);
    }

    // ---------- habits ----------
    // Habits are archived (isActive = false), never deleted by the client, so research
    // history stays intact. Account deletion removes them server-side.
    // While a habit belongs to an active challenge, its commitment can't be changed: lowering a
    // target mid-challenge would retroactively turn failed days into successful ones and corrupt
    // research data. Archiving (isActive / endDate) stays possible.
    function inActiveChallenge(data) {
      return ('challengeId' in data) && data.challengeId != null
        && exists(/databases/$(database)/documents/challenges/$(data.challengeId))
        && get(/databases/$(database)/documents/challenges/$(data.challengeId)).data.status == 'active';
    }
    match /habits/{habitId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming() && idMatches(habitId);
      allow update: if ownsExisting() && ownsIncoming()
        && unchanged(['id', 'userId'])
        && (!inActiveChallenge(resource.data)
            || unchanged(['challengeId', 'frequency', 'unit', 'targetCount', 'scheduledWeekdays',
                          'startDate', 'isRequired', 'requiresEvidence']));
      allow delete: if false;
    }

    // ---------- habit completions ----------
    function clientSettableStatuses() {
      return ['pending', 'selfReported', 'pendingVerification', 'skipped', 'accountabilityRequired'];
    }
    // Statuses a client may still move away from. Server-decided outcomes are final for the client.
    function clientMutableStatuses() {
      return ['pending', 'pendingVerification', 'rejected', 'uncertain', 'skipped'];
    }
    // In the AI-assisted condition, evidence-required habits cannot be self-reported.
    function maySelfReport(data) {
      return data.status != 'selfReported'
        || myProfile().trackingCondition == 'manual'
        || get(/databases/$(database)/documents/habits/$(data.habitId)).data.requiresEvidence == false;
    }
    function ownsHabit(habitId) {
      return get(/databases/$(database)/documents/habits/$(habitId)).data.userId == request.auth.uid;
    }
    match /habitCompletions/{completionId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && idMatches(completionId)
        && ownsHabit(request.resource.data.habitId)
        && request.resource.data.status in clientSettableStatuses()
        && request.resource.data.trackingCondition == myProfile().trackingCondition
        && !('verificationId' in request.resource.data)
        && maySelfReport(request.resource.data);
      allow update: if ownsExisting() && ownsIncoming()
        && resource.data.status in clientMutableStatuses()
        && request.resource.data.status in clientSettableStatuses()
        && unchanged(['id', 'userId', 'habitId', 'day', 'trackingCondition', 'clientRequestId', 'verificationId'])
        && maySelfReport(request.resource.data);
      allow delete: if false;
    }

    // ---------- evidence ----------
    match /evidence/{evidenceId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && idMatches(evidenceId)
        && request.resource.data.verificationStatus == 'pending'
        && !('verificationResultId' in request.resource.data)
        && request.resource.data.storagePath == 'evidence/' + request.auth.uid + '/' + evidenceId + '.jpg';
      allow update: if false; // verification fields are written by the backend only
      allow delete: if ownsExisting();
    }

    // ---------- verification results (immutable, backend-only) ----------
    match /verifications/{verificationId} {
      allow read: if ownsExisting();
      allow write: if false;
    }

    // ---------- accountability ----------
    match /accountabilityTasks/{taskId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && idMatches(taskId)
        && request.resource.data.status == 'pending'
        && request.resource.data.progress == 0
        && request.resource.data.target is int
        && request.resource.data.target > 0
        && request.resource.data.target <= 150
        // The deadline is fixed at acceptance and at most 48 h away.
        && request.resource.data.deadline > request.time
        && request.resource.data.deadline <= request.time + duration.value(48, 'h');
      // The client may start a task; completion/failure is decided server-side from
      // the recorded exercise sessions.
      allow update: if ownsExisting() && ownsIncoming()
        && resource.data.status in ['pending', 'inProgress']
        && unchanged(['id', 'userId', 'sourceHabitId', 'sourceCompletionId', 'day', 'type', 'target', 'completedAt', 'progress', 'exerciseSessionIds'])
        && request.resource.data.deadline <= resource.data.deadline
        && request.resource.data.status in ['pending', 'inProgress'];
      allow delete: if false;
    }

    // Exercise sessions are written once, at the end of a camera session.
    match /exerciseSessions/{sessionId} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming()
        && idMatches(sessionId)
        && request.resource.data.targetReps is int
        && request.resource.data.targetReps > 0 && request.resource.data.targetReps <= 150
        && request.resource.data.validReps is int && request.resource.data.validReps >= 0
        && request.resource.data.validReps <= request.resource.data.targetReps
        && request.resource.data.invalidReps is int && request.resource.data.invalidReps >= 0
        && request.resource.data.invalidReps <= 500
        && exists(/databases/$(database)/documents/accountabilityTasks/$(request.resource.data.accountabilityTaskId))
        && get(/databases/$(database)/documents/accountabilityTasks/$(request.resource.data.accountabilityTaskId)).data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- challenges ----------
    // Rules are locked once a challenge is active so they can't change mid-study.
    match /challenges/{challengeId} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && idMatches(challengeId);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && unchanged(['id', 'ownerId'])
        && (resource.data.status == 'draft'
            || unchanged(['rules', 'startDate', 'endDate', 'durationDays']))
        // Lifecycle: draft → anything; active → completed / abandoned; finished stays finished.
        && (request.resource.data.status == resource.data.status
            || resource.data.status == 'draft'
            || (resource.data.status == 'active' && request.resource.data.status in ['completed', 'abandoned']));
      allow delete: if false;
    }

    // ---------- usability questionnaire (SUS) ----------
    // Pseudonymous (participant ID, no account ID), create-only, and readable only by
    // researchers (through the export, which recomputes the score from the answers).
    function isLikert(value) { return value is int && value >= 1 && value <= 5; }
    match /usabilityResponses/{responseId} {
      allow read: if isResearcher();
      allow create: if signedIn()
        && idMatches(responseId)
        && request.resource.data.participantId == myProfile().participantId
        && request.resource.data.trackingCondition == myProfile().trackingCondition
        && !('userId' in request.resource.data)
        && request.resource.data.responses is list
        && request.resource.data.responses.size() == 10
        && isLikert(request.resource.data.responses[0]) && isLikert(request.resource.data.responses[1])
        && isLikert(request.resource.data.responses[2]) && isLikert(request.resource.data.responses[3])
        && isLikert(request.resource.data.responses[4]) && isLikert(request.resource.data.responses[5])
        && isLikert(request.resource.data.responses[6]) && isLikert(request.resource.data.responses[7])
        && isLikert(request.resource.data.responses[8]) && isLikert(request.resource.data.responses[9])
        && request.resource.data.score is number
        && request.resource.data.score >= 0 && request.resource.data.score <= 100;
      allow update, delete: if false;
    }

    // ---------- research records (server-written) ----------
    match /dailyRecords/{recordId} {
      allow read: if isResearcher()
        || (signedIn() && resource.data.participantId == myProfile().participantId);
      allow write: if false;
    }
  }
}
