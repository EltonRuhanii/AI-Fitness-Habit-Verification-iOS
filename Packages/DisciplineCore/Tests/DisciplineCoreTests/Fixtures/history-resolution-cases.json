        { "habitId": "read", "day": "2026-09-22", "status": "selfReported" },
        { "habitId": "read", "day": "2026-09-23", "status": "selfReported" },
        { "habitId": "read", "day": "2026-09-25", "status": "selfReported" }
      ],
      "expected": { "outcomes": ["successful", "successful", "successful", "failed", "successful", "pending"], "current": 1, "longest": 3 }
    },
